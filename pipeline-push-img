pipeline {
    agent any

    stages {
        stage('checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Ujwalkhairnar2004/paytm-from.git'
            }
        }
        stage("build") {
            steps {
                sh "docker build -t $img ."
            }
        }
        stage("tag") {
            steps {
                sh "docker tag $img $repo "
            }
        }
        stage("login") {
            steps {
                sh "docker login -u tinu10 -p $passwd "
            }
        }
        stage("push"){
            steps {
                sh "docker push $repo:latest"
            }
        }
    }
}
